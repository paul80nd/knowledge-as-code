<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reqnroll BDD pilot: Gherkin feature files driving kac.core in-process, as a side-by-side
       comparison with the JSON golden suite. Uses the Reqnroll xUnit v3 provider on the
       Microsoft.Testing.Platform, matching kac.tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Reqnroll generates <name>.feature.cs code-behind (gitignored); drop stale ones on rebuild. -->
    <ReqnrollDeleteObsoleteCodeBehindFilesOnClean>true</ReqnrollDeleteObsoleteCodeBehindFilesOnClean>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <PackageReference Include="xunit.v3" Version="2.0.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../kac.core/kac.core.csproj" />
  </ItemGroup>

</Project>

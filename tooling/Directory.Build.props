<Project>

  <!-- Settings every project under tooling/ takes, so none of them states them separately and none of
       them can drift. A project needing something else overrides it in its own file, where the reason
       sits beside it. -->
  <PropertyGroup>
    <!-- A warning nobody has to fix is a warning nobody reads, and the nullable ones are how a null
         reaches production. CI and a local build answer the same way on purpose: a check that runs in
         one and not the other is how the thing it catches reaches main. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>

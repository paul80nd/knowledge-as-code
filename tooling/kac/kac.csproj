<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kac</ToolCommandName>
    <PackageId>KnowledgeAsCode.Tool</PackageId>
    <!-- Moving this publishes kac once it reaches main. CHANGELOG.md beside this file needs a section for it. -->
    <Version>0.36.0</Version>
    <Authors>Paul Law</Authors>
    <Description>Validator and generator for a knowledge-as-code corpus, driven by its own schema.</Description>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- A link to the release, because notes copied into a published package can never be corrected. -->
    <PackageReleaseNotes>https://github.com/paul80nd/knowledge-as-code/releases/tag/v$(Version)</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/paul80nd/knowledge-as-code</PackageProjectUrl>
    <RepositoryUrl>https://github.com/paul80nd/knowledge-as-code</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>knowledge-as-code;documentation;markdown;validator;wiki;adr</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="../../docs/assets/icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
    <ProjectReference Include="../kac.core/kac.core.csproj" />
  </ItemGroup>

</Project>

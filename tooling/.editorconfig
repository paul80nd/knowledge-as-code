# ---------------------------------------------------------------------------
# Where this repository departs from the SDK defaults above
#
# Each departure is here because the codebase already answers the question one way throughout
# and the template answers it the other. A cleanup run against the defaults would rewrite
# roughly a thousand sites, none of them wrong.
# ---------------------------------------------------------------------------

[*.cs]

# The SDK template sets this false for C# alone, against `insert_final_newline = true` for
# every other file here. A file ending without a newline is a diff that touches the last line
# whenever anything is appended to it.
insert_final_newline = true

# Prose and code wrap at the same margin, which is what the repository's `.editorconfig` says
# for Markdown and what every C# file here already does.
max_line_length = 120

# 786 declarations use `var`. The template prefers the explicit type, which is a defensible
# default and not this codebase's.
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent

# 78 members are expression-bodied, and each is a single line. `when_on_single_line` is the
# rule the code already follows: a one-line body reads better as an expression, and anything
# longer gets a block.
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_local_functions = when_on_single_line:silent

# 187 guard clauses are written without braces — `if (part is "" or ".") continue;`. The point
# of a guard is that the eye passes over it, and `when_multiline` keeps braces where a body
# genuinely needs them.
csharp_prefer_braces = when_multiline:silent

# The template indents a braced case body past its `case` label; all seven here sit at it.
csharp_indent_case_contents_when_block = false

# No file here groups its usings, and `dotnet_sort_system_directives_first` carries the order.
dotnet_separate_import_directive_groups = false

# Every file is in the `kac.core` namespace, whatever folder holds it. `Checks/` and `Rules/` group
# files by the job they do rather than by who calls them, and nothing outside either folder names it
# to reach what is inside. The template asks the namespace to follow the folder, which would put one
# in front of every one of those calls.
#
# Two keys, because two analysers ask the question. The first is the .NET one, and the second is
# ReSharper's, which is what a JetBrains IDE reads.
dotnet_style_namespace_match_folder = false
resharper_check_namespace_highlighting = none

# A wrapped binary expression carries the operator at the start of the continuation line: 79
# such continuations, against none the other way. There is no vendor-neutral property for it,
# so this is a ReSharper key and other formatters will not read it.
resharper_csharp_wrap_before_binary_opsign = true

# ReSharper's own defaults, written down so no IDE profile re-wraps an initialiser on width alone.
resharper_csharp_keep_existing_initializer_arrangement = true
resharper_csharp_keep_existing_linebreaks = true

# Trailing comments annotating a run of members line up in a column.
resharper_csharp_int_align_comments = true

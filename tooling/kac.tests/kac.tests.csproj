<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects build as an executable on the Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../kac.core/kac.core.csproj" />
    <!-- CliReferenceTests asks the built tool for its command model, so the build has to have produced one. -->
    <ProjectReference Include="../kac/kac.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where that build put it. Only MSBuild knows the configuration, so it writes the path in rather than
         leaving the test to guess at one. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KacAssembly</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../kac/bin/$(Configuration)/$(TargetFramework)/kac.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

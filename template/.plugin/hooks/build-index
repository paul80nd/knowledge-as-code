#!/usr/bin/env sh
# build-index — the PreToolUse hook. Prints the JSON `kac bundle` rendered beside it once a session, so the session
# reads the build index as context. hooks/hooks.json says which tool calls reach it. Without that file it prints nothing.
# A JSON string escapes every quote inside it, so `"session_id"` with bare quotes is the key and nothing else. A marker
# made with mkdir fires once, because only one of two parallel calls creates it.
here=$(dirname "$0")
[ -f "$here/build-index.json" ] || exit 0

id=$(tr -d '\r\n' | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9_-]*\)".*/\1/p')
markers="${CLAUDE_PLUGIN_DATA:-${TMPDIR:-/tmp}}/build-index"

if [ -n "$id" ] && mkdir -p "$markers" 2>/dev/null; then
  find "$markers/." ! -name . -prune -type d -mtime +7 -exec rmdir {} + 2>/dev/null
  mkdir "$markers/$id" 2>/dev/null || [ ! -d "$markers/$id" ] || exit 0
fi

cat "$here/build-index.json"

{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "knowledge-as-code",
  "displayName": "Knowledge as Code",
  "version": "0.1.0",
  "description": "Answers questions about the knowledge-as-code corpus from the export bundled beside it, starting with the glossary.",
  "author": {
    "name": "Paul Law",
    "url": "https://github.com/paul80nd"
  },
  "homepage": "https://github.com/paul80nd/knowledge-as-code",
  "repository": "https://github.com/paul80nd/knowledge-as-code",
  "license": "MIT",
  "keywords": [
    "knowledge-as-code",
    "glossary"
  ],
  "metadata": {
    "corpusRoot": "corpus",
    "components": [
      {
        "path": "skills/glossary-lookup",
        "requires": [
          "glossary"
        ],
        "note": "Reads a term from corpus/glossary/terms.jsonl and the owning glossary record beside it."
      }
    ]
  }
}

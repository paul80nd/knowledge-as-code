{
  "bundleVersion": 1,
  "plugin": "example-libraries",
  "version": "0.1.3",
  "corpusRoot": "corpus",
  "export": {
    "formatVersion": 3,
    "corpus": "example-libraries",
    "contentVersion": "0.1.3",
    "types": [
      "glossary"
    ]
  },
  "included": [
    {
      "path": "skills/glossary-lookup",
      "requires": [
        "glossary@1"
      ],
      "note": "Reads a term from corpus/glossary/terms.jsonl and the owning glossary record beside it."
    },
    {
      "path": "hooks",
      "requires": [
        "glossary"
      ],
      "note": "A SessionStart hook printing the breadcrumb rendered beside it, so a session learns the glossary is here before it has a term to look up."
    }
  ],
  "trimmed": [
    {
      "path": "skills/policy-lookup",
      "requires": [
        "policies@2"
      ],
      "reason": "the export carries no policies"
    }
  ]
}

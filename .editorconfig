# Shared editor conventions for this repository, so a save does not fight the generators.
#
# Markdown, YAML and JSON are settled here, because every folder writes all three. So are JSON
# Lines, which an export writes, and the solution file, because it sits here. The languages only
# the tool writes are settled in `tooling/.editorconfig`, which adds to this file rather than
# replacing it. The corpora under `examples/` take these rules as well, and each claims
# `.editorconfig` with a `skip:` entry so no update sends it the template's copy.
#
# For Markdown this covers whitespace alone. It cannot pin how a formatter renders a markdown
# table — see the note under [*.md] for what actually guards that.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.md]
indent_size = 2
max_line_length = 120

# Reflow prose to the 120 margin, so hand-written sections match what the generators
# emit. Both properties are needed: wrap_text_if_long breaks over-long lines, and
# keep_line_breaks = false lets the short lines below them be pulled back up. Setting
# only the first gives ragged output rather than a reflow.
#
# The one trailing-space hard break in the corpus is the legend under a generated schema
# table, which a reflow must leave alone. `kac generate --check` fails if one eats it.
ij_markdown_wrap_text_if_long = true
ij_markdown_keep_line_breaks_inside_text_blocks = false

# kac writes table separators as |------|, dashes filling the padding cells, because that
# is the form the JetBrains formatter normalises to. There is no vendor-neutral property
# for this, so a formatter preferring | ---- | (Prettier, for one) will still disagree and
# this file cannot stop it. CI is the real guard: `kac generate --check` fails on any generated
# file that differs from what the generator would write.
ij_markdown_format_tables = true

[*.{yaml,yml}]
indent_size = 2

# A flow sequence is written `[a, b]`. One form across the repository, so a file does not
# reformat on its way from one folder to another.
ij_yaml_spaces_within_brackets = false

[*.json]
indent_size = 2

# JSON Lines is one object per line, which the JSON formatter's defaults split over many.
# These hold a format run to the compact form `kac export` writes. Only a JetBrains IDE reads
# them, so `JsonLinesTests` is the guard.
[*.jsonl]
max_line_length = off
ij_json_object_wrapping = off
ij_json_array_wrapping = off
ij_json_space_after_colon = false
ij_json_space_after_comma = false
ij_json_spaces_within_braces = false
ij_json_spaces_within_brackets = false

# MSBuild indents by two and spaces the self-closing slash; the second is an IntelliJ key.
# The project files take the same rules from `tooling/.editorconfig`, beside the projects.
[*.slnx]
indent_size = 2
ij_xml_space_inside_empty_tag = true
